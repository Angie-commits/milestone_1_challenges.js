//Challenge 1;Sum of positives
function sumOfPositives(arr) {
  if (!Array.isArray(arr)) {
    return "Input must be an array";
  }
   let sum = 0;
  for (let i = 0; i < arr.length; i++) {
    if (arr[i] > 0) {
      sum += arr[i];
    }
  } 
 return sum;
}
console.log(sumOfPositives([1, -3, 5, -2, 9, -8])); // 15 (1 + 5 + 9)
console.log(sumOfPositives([-1, -2, -3])); // 0 (no positive numbers)
console.log(sumOfPositives([2, 4, 6, 8])); // 20 (all positive numbers)
console.log(sumOfPositives([])); // 0 (empty array)

