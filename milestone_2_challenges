//Challenge 10;Finding average of numbers
function average(numbers) {
  if (numbers.length === 0) return 0;
   const sum = numbers.reduce((acc, num) => acc + num, 0);
  return sum / numbers.length;
}
console.log(average([2, 4, 6, 8]));
console.log(average([]));

