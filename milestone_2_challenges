//Challenge 5;Counting properties
function countProperties(obj) {  
  if (typeof obj !== 'object' || obj === null || Array.isArray(obj)) {
    return "Input must be an object";
  }
  let count = 0;
  for (let key in obj) {
  if (obj.hasOwnProperty(key)) {
      count++;
    }
  }
  return count;
}
console.log(countProperties({ a: 1, b: 2, c: 3, d: 4, e: 5 }));

//Challenge 6; Filter by length
function filterByLength(strings, minLength) {
  if (!Array.isArray(strings)) {
    return "First argument must be an array";
  }
  if (typeof minLength !== 'number') {
    return "Second argument must be a number";
  }
  
  const result = [];
  for (let i = 0; i < strings.length; i++) {
    if (typeof strings[i] === 'string' && strings[i].length >= minLength) {
      result.push(strings[i]);
    }
  }
   return result;
}
console.log(filterByLength(["short", "tiny", "big"], 10))

//Challenge 7; Finding sum of even numbers
function sumEvenNumbers(numbers) {
  if (!Array.isArray(numbers)) {
    return "Input must be an array";
  } 
  let sum = 0;
  for (let i = 0; i < numbers.length; i++) {
  if (typeof numbers[i] === 'number' && numbers[i] % 2 === 0) {
      sum += numbers[i];
    }
  }
  return sum;
}
console.log(sumEvenNumbers([1, 3, 5, 7, 9]));
console.log(sumEvenNumbers([-4, -2, 0, 2, 4]));

//Challenge 8;Finding difference between even and odd numbers
function differenceEvenOdd(numbers) {
  if (!Array.isArray(numbers)) {
    return "Input must be an array";
  } 
  let evenSum = 0;
  let oddSum = 0;
  for (let i = 0; i < numbers.length; i++) {
    if (typeof numbers[i] === 'number') {
    if (numbers[i] % 2 === 0) {
        evenSum += numbers[i];
      } else {
        oddSum += numbers[i];
      }
    }
  }
  return evenSum - oddSum;
}
console.log(differenceEvenOdd([1, 5, 7]));
console.log(differenceEvenOdd([-6, -8, 0, 8, 6]));

